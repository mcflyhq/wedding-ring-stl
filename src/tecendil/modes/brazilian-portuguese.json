    "/([aeiouà-úAEIOUÀ-Ú])[xX]([^aeiouà-úAEIOUÀ-Ú])/": "$1s$2", 

    
    "/([^qgQG])(ue|UE)([sS])?$/": "$1_dtcxi_i$3", 
    "/(ul|UL)($|[^aeiouà-úAEIOUÀ-Ú])/": "_dtdxu_u$2", 

    
    "/([ãõÃÕ])[eE]([sS])?$/": "$1i$2",
    "/([^aeiouà-úAEIOUÀ-Ú]||(qu|QU))[eE]([sS])?$/": "$1i$3",
    "/([^aeiouà-úAEIOUÀ-Ú]||[ãÃ])[oO]([sS])?$/": "$1u$2", 
    "/([eE])[oO]([sS])?$/": "_dtcxu_u$2",
    "/([aãAÃ])([mnMN])$/": "ãu",
    "/([eéEÉ])([mnMN])([sS])?$/": "ei_nzl_$3",
    "/([aeiouà-úAEIOU]||[ãÃ])[lL]$/": "$1u",

    
    
    "/([aeiouà-úAEIOUÀ-Ú])[nmNM]((s)?$|[^haeiouà-úHAEIOUÀ-Ú_])/": "$1_nzl_$2",

    
    "/^[cC]([eéêiíEÉÊIÍ])/": "s$1", 
    "/[cC]([eéêiíEÉÊIÍ])/": "ss$1",

    
    "/([aeiouà-úAEIOUÀ-Ú])[sS]([aeiouà-úAEIOUÀ-Ú])/": "$1z$2",

    "/([aeiouà-úAEIOU])[lL]([^haeiouà-úHAEIOUÀ-Ú])/": "$1u$2",

    
    "/[zZ]$/": "s",

    
    "ch": "x",

    
    "/[gG]([eéèêëiíìEÉÈÊËIÍÌ])/": "j$1",

    
    "/(gu|GU)([aáãoóõAÁÃOÓÕ])/": "gü$2",
    "/(gu|GU)([eéêiíEÉÊIÍ])/": "g$2",

    
    "/(qu|QU)([eéêiíEÉÊIÍ])/": "k$2",

    
    
    

    
    "/[dD]([iíìIÍÌ])/": "_dfric_$1", 

    
    "/[tT]([iíìIÍÌ])/": "_tfric_$1",

    

    
    "/([aeiouà-úAEIOUÀ-Ú])[rR]([aeiouà-úAEIOUÀ-Ú])/": "$1r$2",

    
    "/([^AaEeIiOoUuÁáÉéÍíÓóÚúRr])[rR]/": "$1r", 

    
    "/([lLnN])[rR]/": "$1rr",

    
    
    

    

    "/[iI]([aeioAEIO])/": "_ditix_$1", 
    "/([^qgQG])[uU]([aeouAEOU])/": "$1_ditux_$2", 

    "/[iI][úÚ]([sS])?$/": "_dtcxu_u$1", 

    
    "/([aãâeéêoóõuAÃÂEÉOÓÕU])[iI]/": "_ditxi_$1", 
    "/([aáãâeéoóiuAÁÃÂEÉIOÓU])[uU]/": "_ditxu_$1", 

    
    
    
    

    
    
    
    
    
    

    
    "/([mM])_ditxi_([uU])([tT]||_tfric_)/": "$1_ditxi_$2_nzl_$3"
  },

  "map": {
    
